{
  "manifest_version": 3,
  "name": "Autodarts Webpanel",
  "description": "Findet das Autodarts Webpanel automatisch im Netzwerk und öffnet es per Klick.",
  "version": "1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.autodarts.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autodarts Webpanel"
  },
  "icons": {
    "16":  "icons/icon.svg",
    "48":  "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
