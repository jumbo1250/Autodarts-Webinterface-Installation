#!/usr/bin/env bash
# autodarts-tui-wrapper
# Wird von ttyd als TUI-Kommando aufgerufen.
# Stellt sicher dass autodarts -H 127.0.0.1 bei geschlossenem Browser-Tab
# beendet wird (ttyd sendet HUP an das Terminal wenn der Client trennt).

AD_BIN="${HOME}/.local/bin/autodarts"

# Verwaiste Instanzen aus abgebrochenen Sessions bereinigen
pkill -u "$(id -un)" -f "${AD_BIN} -H 127.0.0.1" 2>/dev/null || true
sleep 0.3

_reset_terminal() {
    # Alle Mouse-Tracking-Modi deaktivieren (1000=normal, 1002=button, 1003=any-motion, 1006=SGR, 1015=urxvt)
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l' 2>/dev/null || true
    # Alternate-Screen verlassen falls autodarts darauf war
    printf '\033[?1049l' 2>/dev/null || true
    # Cursor sichtbar machen
    printf '\033[?25h' 2>/dev/null || true
    stty sane 2>/dev/null || true
}

_cleanup() {
    kill -TERM "$AD_PID" 2>/dev/null || true
    sleep 0.5
    kill -KILL "$AD_PID" 2>/dev/null || true
    _reset_terminal
}
trap '_cleanup' HUP TERM INT EXIT

# Terminal vor dem Start aufräumen (sauberer Zustand nach vorheriger Session)
_reset_terminal

"$AD_BIN" -H 127.0.0.1 &
AD_PID=$!
wait "$AD_PID"
